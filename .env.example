# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite:///./email_sender.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/email_sender

# Redis Configuration (For Celery worker queue)
REDIS_URL=redis://localhost:6379/0

# JWT & Security Configuration
SECRET_KEY=change-this-super-secret-key-in-production-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP Configuration Default (Can also be set per-user via Settings API)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_NAME=Email Campaign Management System

# CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Application Settings
MAX_RETRIES=3
ATTACHMENT_MAX_SIZE_MB=10
UPLOAD_DIR=uploads
LOG_DIR=logs

